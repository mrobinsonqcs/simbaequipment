{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.simbaequipment.com" }],
      "status": 301,
      "headers": { "Location": "https://simbaequipment.com/$1" }
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
